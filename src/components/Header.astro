---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/products', label: 'Products' },
  { href: '/contact', label: 'Contact' },
];

const pathname = Astro.url.pathname;
// Normalize: treat trailing slash variants as the same
function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
---

<header id="site-header" class="site-header">
  <div class="header-inner">
    <!-- Logo -->
    <a href="/" class="logo-link" aria-label="RnJ Software — Home">
      <img src="/logo.png" alt="RnJ Software" class="logo-img" width="140" height="40" />
    </a>

    <!-- Desktop Nav -->
    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul role="list">
        {navLinks.map(({ href, label }) => {
          const active = isActive(href);
          return (
            <li>
              <a
                href={href}
                class={`nav-link ${active ? 'nav-link--active' : ''}`}
                aria-current={active ? 'page' : undefined}
              >
                {active && <span class="nav-prompt" aria-hidden="true">{'>'}_</span>}
                <span class="nav-label">{label}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Mobile Menu Toggle -->
    <button
      id="menu-toggle"
      class="menu-toggle"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open navigation menu"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <!-- Mobile Nav -->
  <nav
    id="mobile-menu"
    class="mobile-nav"
    aria-label="Mobile navigation"
    hidden
  >
    <ul role="list">
      {navLinks.map(({ href, label }) => {
        const active = isActive(href);
        return (
          <li>
            <a
              href={href}
              class={`mobile-nav-link ${active ? 'mobile-nav-link--active' : ''}`}
              aria-current={active ? 'page' : undefined}
            >
              <span class="mobile-nav-indicator" aria-hidden="true">
                {active ? '▶' : '—'}
              </span>
              <span>{label}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      toggle.setAttribute('aria-label', expanded ? 'Open navigation menu' : 'Close navigation menu');
      toggle.classList.toggle('is-open', !expanded);
      if (expanded) {
        menu.hidden = true;
      } else {
        menu.hidden = false;
        // Focus first link for keyboard accessibility
        const firstLink = menu.querySelector('a');
        if (firstLink) (firstLink as HTMLAnchorElement).focus();
      }
    });

    // Close on Escape; focus-trap Tab/Shift+Tab while menu is open
    document.addEventListener('keydown', (e) => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';

      if (e.key === 'Escape' && isOpen) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open navigation menu');
        toggle.classList.remove('is-open');
        menu.hidden = true;
        toggle.focus();
        return;
      }

      if (e.key === 'Tab' && isOpen) {
        // Focusable elements within the menu: toggle button + all nav links
        const focusable: HTMLElement[] = [
          toggle,
          ...Array.from(menu.querySelectorAll<HTMLAnchorElement>('a')),
        ];
        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (e.shiftKey) {
          // Shift+Tab: if focus is on the first element, wrap to last
          if (document.activeElement === first) {
            e.preventDefault();
            last.focus();
          }
        } else {
          // Tab: if focus is on the last element, wrap to first
          if (document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    });

    // Close when a mobile nav link is clicked
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open navigation menu');
        toggle.classList.remove('is-open');
        menu.hidden = true;
      });
    });
  }

  // Scroll-aware sticky: add scrolled class after 8px
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-ink-900);
    border-bottom: 1px solid var(--color-border-dark);
    transition: box-shadow 0.2s ease, backdrop-filter 0.2s ease;
  }

  .site-header.is-scrolled {
    box-shadow: 0 1px 24px rgb(15 15 15 / 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background-color: rgb(26 26 26 / 0.95);
  }

  .header-inner {
    max-width: var(--container-site);
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
    height: 4rem;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /* Logo */
  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    border-radius: var(--radius-xs);
    transition: opacity 0.15s ease;
  }
  .logo-link:hover { opacity: 0.85; }
  .logo-link:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 3px;
  }

  .logo-img {
    height: 28px;
    width: auto;
    /* Invert the B&W logo so it renders white on dark header */
    filter: invert(1);
    display: block;
  }

  /* Desktop Nav */
  .desktop-nav {
    margin-left: auto;
  }
  .desktop-nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-xs);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-gray-300);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: color 0.15s ease, background-color 0.15s ease;
    position: relative;
  }

  .nav-link:hover {
    color: var(--color-paper);
    background-color: var(--color-ink-700);
  }

  .nav-link--active {
    color: var(--color-paper);
  }

  .nav-prompt {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-signal);
    letter-spacing: 0;
    line-height: 1;
    font-weight: 500;
    /* slight vertical nudge */
    position: relative;
    top: 0.5px;
  }

  .nav-label {
    position: relative;
  }

  /* Active underline tick */
  .nav-link--active .nav-label::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 1px;
    background-color: var(--color-signal);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 2px;
  }

  /* Hamburger */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    background: transparent;
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-xs);
    cursor: pointer;
    margin-left: auto;
    padding: 0.5rem;
    transition: border-color 0.15s ease;
  }
  .menu-toggle:hover { border-color: var(--color-gray-600); }
  .menu-toggle:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 2px;
  }

  .hamburger-line {
    display: block;
    width: 18px;
    height: 1.5px;
    background-color: var(--color-gray-300);
    border-radius: 1px;
    transition: transform 0.2s ease, opacity 0.2s ease;
    transform-origin: center;
  }

  /* Animate hamburger → X */
  .menu-toggle.is-open .hamburger-line:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .menu-toggle.is-open .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .menu-toggle.is-open .hamburger-line:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* Mobile Nav */
  .mobile-nav {
    background-color: var(--color-ink-800);
    border-top: 1px solid var(--color-border-dark);
  }

  .mobile-nav ul {
    max-width: var(--container-site);
    margin-inline: auto;
    padding: 0.75rem var(--spacing-gutter) 1rem;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-xs);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-gray-300);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .mobile-nav-link:hover {
    color: var(--color-paper);
    background-color: var(--color-ink-700);
  }

  .mobile-nav-link--active {
    color: var(--color-paper);
    background-color: var(--color-ink-700);
  }

  .mobile-nav-indicator {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-signal);
    width: 0.75rem;
    flex-shrink: 0;
  }

  .mobile-nav-link:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 2px;
  }

  /* Responsive breakpoint */
  @media (max-width: 48rem) {
    .desktop-nav { display: none; }
    .menu-toggle { display: flex; }
  }
</style>
