---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with RnJ Software LLC. Have a project in mind or a question for our team? Send us a message and we'll get back to you within one business day."
>

  <!-- =====================================================================
       1. PAGE HERO
       ===================================================================== -->
  <section class="page-hero" aria-labelledby="contact-hero-heading">
    <!-- Blueprint grid background -->
    <div class="page-hero-grid" aria-hidden="true"></div>
    <!-- Scan line overlay -->
    <div class="page-hero-scanline" aria-hidden="true"></div>

    <div class="page-hero-inner">
      <!-- Eyebrow -->
      <p class="hero-eyebrow" aria-hidden="true">
        <span class="eyebrow-bracket">[</span>
        <span class="eyebrow-text">RNJ-SW // CTT-001</span>
        <span class="eyebrow-bracket">]</span>
      </p>

      <h1 id="contact-hero-heading" class="page-hero-heading">
        Get in touch
      </h1>

      <p class="page-hero-subhead">
        Have a project in mind or a question for our team? Send us a message and we'll get back to you.
      </p>
    </div>

    <!-- Decorative rule lines -->
    <div class="hero-rule hero-rule--h" aria-hidden="true"></div>
    <div class="hero-rule hero-rule--v" aria-hidden="true"></div>
  </section>

  <!-- =====================================================================
       2. CONTACT CONTENT
       ===================================================================== -->
  <section class="section contact-section" aria-labelledby="contact-form-heading">
    <div class="section-inner contact-inner">

      <!-- Left: Form column -->
      <div class="form-column">
        <header class="form-header">
          <p class="section-eyebrow" aria-hidden="true">
            <span class="eyebrow-mono">// SEND A MESSAGE</span>
          </p>
          <h2 id="contact-form-heading" class="section-heading">Drop us a line</h2>
        </header>

        <!-- Status region — announced to assistive tech -->
        <div
          id="form-status"
          role="status"
          aria-live="polite"
          aria-atomic="true"
          class="form-status"
        ></div>

        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="contact-form"
        >
          <!-- Hidden: Web3Forms access key (public form identifier — safe to commit) -->
          <input type="hidden" name="access_key" value="4018e3cb-2619-4118-aa61-2e914eaab999" />

          <!-- Hidden: subject -->
          <input type="hidden" name="subject" value="New message from rnj-software.com" />

          <!-- Hidden: redirect for no-JS users -->
          <input type="hidden" name="redirect" value="https://rnj-software.com" />

          <!-- Honeypot: visually hidden, off-screen, hidden from AT and tab order -->
          <input
            type="checkbox"
            name="botcheck"
            class="honeypot"
            tabindex="-1"
            aria-hidden="true"
            autocomplete="off"
          />

          <!-- Name field -->
          <div class="field-group">
            <label for="name" class="field-label">
              Name
              <span class="field-required" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              class="field-input"
              required
              aria-required="true"
              autocomplete="name"
              placeholder="Your full name"
            />
          </div>

          <!-- Email field -->
          <div class="field-group">
            <label for="email" class="field-label">
              Email address
              <span class="field-required" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              class="field-input"
              required
              aria-required="true"
              autocomplete="email"
              placeholder="you@example.com"
            />
          </div>

          <!-- Message field -->
          <div class="field-group">
            <label for="message" class="field-label">
              Message
              <span class="field-required" aria-hidden="true">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              class="field-input field-textarea"
              required
              aria-required="true"
              rows="6"
              placeholder="Tell us about your project or question…"
            ></textarea>
          </div>

          <!-- Required fields note -->
          <p class="required-note">
            <span aria-hidden="true">*</span> Required fields
          </p>

          <!-- Submit -->
          <button type="submit" id="submit-btn" class="btn btn--primary submit-btn">
            <span class="btn-label">Send message</span>
            <svg class="btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </form>
      </div>

      <!-- Right: Direct contact details -->
      <aside class="contact-details" aria-label="Direct contact information">
        <!-- Blueprint corner decoration -->
        <div class="details-corner-tl" aria-hidden="true"></div>
        <div class="details-corner-br" aria-hidden="true"></div>

        <div class="details-inner">
          <p class="section-eyebrow" aria-hidden="true">
            <span class="eyebrow-mono">// DIRECT CONTACT</span>
          </p>

          <div class="detail-block">
            <h3 class="detail-label">Email</h3>
            <a href="mailto:support@rnj-software.com" class="detail-link">
              support@rnj-software.com
            </a>
          </div>

          <div class="detail-divider" aria-hidden="true"></div>

          <div class="detail-block">
            <h3 class="detail-label">Mailing address</h3>
            <address class="detail-address">
              RnJ Software LLC<br />
              5944 Coral Ridge Dr #1091<br />
              Coral Springs, FL 33076
            </address>
          </div>

          <div class="detail-divider" aria-hidden="true"></div>

          <div class="detail-block">
            <h3 class="detail-label">Response time</h3>
            <p class="detail-body">
              We aim to respond to all inquiries within one business day.
            </p>
          </div>

          <!-- Blueprint reference annotation -->
          <div class="details-ref-row" aria-hidden="true">
            <span class="details-ref">CTT-001</span>
            <div class="details-ref-line"></div>
          </div>
        </div>
      </aside>

    </div>
  </section>

</BaseLayout>

<style>
  /* ==========================================================================
     Shared utilities
     ========================================================================== */

  .section-eyebrow {
    margin-bottom: 0.75rem;
  }

  .eyebrow-mono {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    color: var(--color-signal);
    text-transform: uppercase;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink-900);
    line-height: var(--leading-tight);
    margin: 0 0 1rem;
  }

  .section {
    padding-block: var(--spacing-section-y);
  }

  .section-inner {
    max-width: var(--container-site);
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: background-color 0.15s ease, color 0.15s ease,
                box-shadow 0.15s ease, transform 0.15s ease;
    white-space: nowrap;
    cursor: pointer;
    border: none;
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 3px;
  }

  .btn--primary {
    background-color: var(--color-signal);
    color: var(--color-surface-card);
  }

  .btn--primary:hover {
    background-color: var(--color-signal-hover);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--color-signal) 30%, transparent);
  }

  .btn--primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .btn-arrow {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .btn:not(:disabled):hover .btn-arrow {
    transform: translateX(3px);
  }

  /* ==========================================================================
     1. PAGE HERO
     ========================================================================== */

  .page-hero {
    position: relative;
    background-color: var(--color-ink-900);
    overflow: hidden;
    padding-block: 6rem 5rem;
    isolation: isolate;
  }

  /* Blueprint grid */
  .page-hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: linear-gradient(to bottom, rgb(0 0 0 / 0.6) 0%, transparent 90%);
    mask-image: linear-gradient(to bottom, rgb(0 0 0 / 0.6) 0%, transparent 90%);
    pointer-events: none;
  }

  /* Scan line */
  .page-hero-scanline {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3px,
      rgb(255 255 255 / 0.012) 3px,
      rgb(255 255 255 / 0.012) 4px
    );
    pointer-events: none;
    z-index: 1;
  }

  /* Decorative rule lines */
  .hero-rule {
    position: absolute;
    background-color: rgb(255 255 255 / 0.06);
    pointer-events: none;
  }

  .hero-rule--h {
    left: 0;
    right: 0;
    height: 1px;
    top: 50%;
  }

  .hero-rule--v {
    top: 0;
    bottom: 0;
    width: 1px;
    left: calc(var(--spacing-gutter) + 2px);
  }

  .page-hero-inner {
    position: relative;
    z-index: 2;
    max-width: var(--container-site);
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  /* Eyebrow */
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    color: var(--color-gray-500);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.375rem;

    opacity: 0;
    transform: translateY(8px);
    animation: fade-up 0.5s ease 0.05s forwards;
  }

  .eyebrow-bracket {
    color: var(--color-signal);
    font-size: 0.8rem;
  }

  .eyebrow-text {
    letter-spacing: 0.1em;
  }

  /* H1 */
  .page-hero-heading {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--color-paper);
    line-height: var(--leading-tight);
    margin: 0 0 1.5rem;

    opacity: 0;
    transform: translateY(16px);
    animation: fade-up 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.15s forwards;
  }

  .page-hero-subhead {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    color: var(--color-gray-400);
    line-height: var(--leading-normal);
    max-width: 42rem;
    margin: 0;

    opacity: 0;
    transform: translateY(10px);
    animation: fade-up 0.55s ease 0.3s forwards;
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .page-hero-heading,
    .page-hero-subhead {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  @media (max-width: 48rem) {
    .page-hero {
      padding-block: 4.5rem 3.5rem;
    }
  }

  /* ==========================================================================
     2. CONTACT SECTION — Two-column layout
     ========================================================================== */

  .contact-section {
    background-color: var(--color-paper-soft);
    border-top: 1px solid var(--color-border);
  }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 22rem;
    gap: 4rem;
    align-items: start;
  }

  /* --------------------------------------------------------------------------
     Form column
     -------------------------------------------------------------------------- */

  .form-header {
    margin-bottom: 2rem;
  }

  /* Status region */
  .form-status {
    margin-bottom: 0;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: var(--leading-normal);
    /* Hidden until JS populates it */
  }

  .form-status:not(:empty) {
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
  }

  .form-status.status--success {
    background-color: color-mix(in srgb, #16a34a 10%, transparent);
    border: 1px solid color-mix(in srgb, #16a34a 30%, transparent);
    color: #15803d;
  }

  .form-status.status--error {
    background-color: color-mix(in srgb, #dc2626 10%, transparent);
    border: 1px solid color-mix(in srgb, #dc2626 30%, transparent);
    color: #b91c1c;
  }

  /* The form itself */
  .contact-form {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Field group: label + input */
  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field-label {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-900);
    letter-spacing: 0.01em;
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .field-required {
    color: var(--color-signal);
    font-size: 0.9em;
    line-height: 1;
  }

  .field-input {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-ink-900);
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    padding: 0.6875rem 0.875rem;
    width: 100%;
    line-height: var(--leading-normal);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    appearance: none;
  }

  .field-input::placeholder {
    color: var(--color-gray-400);
  }

  .field-input:hover {
    border-color: var(--color-gray-300);
  }

  .field-input:focus {
    outline: none;
    border-color: var(--color-signal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-signal) 15%, transparent);
  }

  .field-textarea {
    resize: vertical;
    min-height: 9rem;
  }

  .required-note {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-gray-500);
    margin: -0.25rem 0 0;
    line-height: 1.4;
  }

  .submit-btn {
    align-self: flex-start;
    margin-top: 0.25rem;
  }

  /* Honeypot — off-screen, out of tab order, hidden from AT */
  .honeypot {
    position: absolute;
    left: -9999px;
    top: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* --------------------------------------------------------------------------
     Details aside
     -------------------------------------------------------------------------- */

  .contact-details {
    position: relative;
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    /* Align with the section heading on the left */
    margin-top: 0;
  }

  /* Blueprint corner marks */
  .details-corner-tl,
  .details-corner-br {
    position: absolute;
    width: 1.25rem;
    height: 1.25rem;
    pointer-events: none;
    z-index: 1;
  }

  .details-corner-tl {
    top: 0.75rem;
    left: 0.75rem;
    border-top: 1.5px solid var(--color-signal);
    border-left: 1.5px solid var(--color-signal);
    border-radius: var(--radius-xs) 0 0 0;
    opacity: 0.45;
  }

  .details-corner-br {
    bottom: 0.75rem;
    right: 0.75rem;
    border-bottom: 1.5px solid var(--color-signal);
    border-right: 1.5px solid var(--color-signal);
    border-radius: 0 0 var(--radius-xs) 0;
    opacity: 0.45;
  }

  .details-inner {
    padding: 2rem;
  }

  .detail-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .detail-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    color: var(--color-signal);
    text-transform: uppercase;
    margin: 0;
  }

  .detail-link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-900);
    text-decoration: none;
    word-break: break-all;
    transition: color 0.15s ease;
  }

  .detail-link:hover {
    color: var(--color-signal);
  }

  .detail-link:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 2px;
    border-radius: var(--radius-xs);
  }

  .detail-address {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-style: normal;
    color: var(--color-gray-700);
    line-height: var(--leading-normal);
  }

  .detail-body {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .detail-divider {
    height: 1px;
    background-color: var(--color-border);
    margin-block: 1.25rem;
  }

  /* Blueprint reference annotation at bottom */
  .details-ref-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }

  .details-ref {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    color: var(--color-gray-300);
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .details-ref-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      to right,
      var(--color-border),
      transparent
    );
  }

  /* --------------------------------------------------------------------------
     Responsive
     -------------------------------------------------------------------------- */

  @media (max-width: 64rem) {
    .contact-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .contact-details {
      /* On mobile, details card appears below the form in source order */
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status') as HTMLDivElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnLabel = submitBtn?.querySelector('.btn-label') as HTMLSpanElement | null;

  if (form && statusEl && submitBtn && btnLabel) {
    // Shared helper: restore button to its default ready state
    function restoreButton(): void {
      submitBtn!.disabled = false;
      btnLabel!.textContent = 'Send message';
    }

    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault();

      // Disable button and show loading state
      submitBtn.disabled = true;
      btnLabel.textContent = 'Sending…';

      // Clear previous status
      statusEl.textContent = '';
      statusEl.className = 'form-status';

      const formData = new FormData(form);
      const data: Record<string, string> = {};
      formData.forEach((value, key) => {
        data[key] = value as string;
      });

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          // Success state
          statusEl.textContent = "Message sent! We'll get back to you within one business day.";
          statusEl.className = 'form-status status--success';
          form.reset();
          restoreButton();
        } else {
          throw new Error(result.message || 'Submission failed');
        }
      } catch (err) {
        // Error state
        statusEl.textContent = 'Something went wrong. Please try again or email us directly at support@rnj-software.com.';
        statusEl.className = 'form-status status--error';
        restoreButton();
      }
    });
  }
</script>
