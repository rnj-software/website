---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist. Head back to the RnJ Software homepage."
>
  <section class="not-found" aria-labelledby="not-found-heading">

    <!-- Blueprint grid background -->
    <div class="nf-grid" aria-hidden="true"></div>

    <!-- Scan line overlay -->
    <div class="nf-scanline" aria-hidden="true"></div>

    <!-- Ghost 404 watermark -->
    <span class="nf-watermark" aria-hidden="true">404</span>

    <!-- Decorative rule lines -->
    <div class="nf-rule nf-rule--h" aria-hidden="true"></div>
    <div class="nf-rule nf-rule--v" aria-hidden="true"></div>

    <div class="nf-inner">

      <!-- Eyebrow -->
      <p class="nf-eyebrow" aria-hidden="true">
        <span class="nf-eyebrow-bracket">[</span>
        <span class="nf-eyebrow-text">// 404 // NOT_FOUND</span>
        <span class="nf-eyebrow-bracket">]</span>
      </p>

      <!-- Blueprint corner marks flanking the heading block -->
      <div class="nf-frame" aria-hidden="true">
        <div class="nf-corner nf-corner--tl"></div>
        <div class="nf-corner nf-corner--tr"></div>
        <div class="nf-corner nf-corner--bl"></div>
        <div class="nf-corner nf-corner--br"></div>
      </div>

      <!-- Main heading -->
      <h1 id="not-found-heading" class="nf-heading">
        That page doesn't exist.
      </h1>

      <!-- Supporting sentence -->
      <p class="nf-body">
        The route you followed has no destination. Let's get you back on track.
      </p>

      <!-- CTA -->
      <a href="/" class="btn btn--primary">
        Back to home
        <svg class="btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <!-- Status readout -->
      <div class="nf-status" aria-hidden="true">
        <span class="status-dot"></span>
        <span class="status-text">HTTP 404 · ROUTE UNRESOLVED · RETURN TO ORIGIN</span>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  /* ==========================================================================
     404 — Not Found
     ========================================================================== */

  .not-found {
    position: relative;
    background-color: var(--color-ink-900);
    min-height: calc(100vh - 4rem); /* account for header height */
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
    padding-block: 7rem 6rem;
  }

  /* Blueprint grid */
  .nf-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 40%, rgb(0 0 0 / 0.7) 0%, transparent 100%);
    mask-image: radial-gradient(ellipse 80% 80% at 50% 40%, rgb(0 0 0 / 0.7) 0%, transparent 100%);
    pointer-events: none;
  }

  /* Scan line */
  .nf-scanline {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3px,
      rgb(255 255 255 / 0.012) 3px,
      rgb(255 255 255 / 0.012) 4px
    );
    pointer-events: none;
    z-index: 1;
  }

  /* Ghost watermark */
  .nf-watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-size: clamp(10rem, 28vw, 22rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    color: rgb(255 255 255 / 0.028);
    pointer-events: none;
    user-select: none;
    line-height: 1;
    white-space: nowrap;
    z-index: 1;
  }

  /* Decorative hairlines */
  .nf-rule {
    position: absolute;
    background-color: rgb(255 255 255 / 0.06);
    pointer-events: none;
    z-index: 2;
  }

  .nf-rule--h {
    left: 0;
    right: 0;
    height: 1px;
    top: 50%;
  }

  .nf-rule--v {
    top: 0;
    bottom: 0;
    width: 1px;
    left: calc(var(--spacing-gutter) + 2px);
  }

  /* Inner content wrapper — centered column */
  .nf-inner {
    position: relative;
    z-index: 3;
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Eyebrow */
  .nf-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    color: var(--color-gray-500);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.375rem;

    opacity: 0;
    transform: translateY(8px);
    animation: nf-fade-up 0.5s ease 0.05s forwards;
  }

  .nf-eyebrow-bracket {
    color: var(--color-signal);
    font-size: 0.8rem;
  }

  .nf-eyebrow-text {
    letter-spacing: 0.1em;
    color: var(--color-signal);
    opacity: 0.7;
  }

  /* Blueprint corner frame around the heading */
  .nf-frame {
    position: absolute;
    inset: -1.5rem -2rem;
    pointer-events: none;
  }

  .nf-corner {
    position: absolute;
    width: 1.25rem;
    height: 1.25rem;
  }

  .nf-corner--tl {
    top: 0;
    left: 0;
    border-top: 1.5px solid var(--color-signal);
    border-left: 1.5px solid var(--color-signal);
    border-radius: var(--radius-xs) 0 0 0;
    opacity: 0.35;
  }

  .nf-corner--tr {
    top: 0;
    right: 0;
    border-top: 1.5px solid var(--color-signal);
    border-right: 1.5px solid var(--color-signal);
    border-radius: 0 var(--radius-xs) 0 0;
    opacity: 0.35;
  }

  .nf-corner--bl {
    bottom: 0;
    left: 0;
    border-bottom: 1.5px solid var(--color-signal);
    border-left: 1.5px solid var(--color-signal);
    border-radius: 0 0 0 var(--radius-xs);
    opacity: 0.35;
  }

  .nf-corner--br {
    bottom: 0;
    right: 0;
    border-bottom: 1.5px solid var(--color-signal);
    border-right: 1.5px solid var(--color-signal);
    border-radius: 0 0 var(--radius-xs) 0;
    opacity: 0.35;
  }

  /* Main heading */
  .nf-heading {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--color-paper);
    line-height: var(--leading-tight);
    margin: 0 0 1.25rem;

    opacity: 0;
    transform: translateY(20px);
    animation: nf-fade-up 0.65s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards;
  }

  /* Supporting body */
  .nf-body {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-gray-500);
    line-height: var(--leading-normal);
    max-width: 30rem;
    margin-bottom: 2.5rem;

    opacity: 0;
    transform: translateY(10px);
    animation: nf-fade-up 0.5s ease 0.38s forwards;
  }

  /* Button */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: background-color 0.15s ease, color 0.15s ease,
                box-shadow 0.15s ease, transform 0.15s ease;
    white-space: nowrap;
    cursor: pointer;

    opacity: 0;
    transform: translateY(10px);
    animation: nf-fade-up 0.5s ease 0.52s forwards;
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 3px;
  }

  .btn--primary {
    background-color: var(--color-signal);
    color: var(--color-surface-card);
  }

  .btn--primary:hover {
    background-color: var(--color-signal-hover);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--color-signal) 30%, transparent);
  }

  .btn-arrow {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .btn:hover .btn-arrow {
    transform: translateX(3px);
  }

  /* Status readout */
  .nf-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.75rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--color-gray-700);

    opacity: 0;
    animation: nf-fade-up 0.5s ease 0.7s forwards;
  }

  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--color-signal);
    opacity: 0.5;
    flex-shrink: 0;
  }

  /* Keyframes */
  @keyframes nf-fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .nf-eyebrow,
    .nf-heading,
    .nf-body,
    .btn,
    .nf-status {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  /* Responsive */
  @media (max-width: 48rem) {
    .not-found {
      padding-block: 5rem 4rem;
    }

    .nf-frame {
      display: none;
    }

    .nf-rule--v {
      display: none;
    }
  }
</style>
